---
import Imagotipo from './Imagotipo.astro';
import { siteConfig } from '../config/site.config';

const { hero } = siteConfig;
---

<section class="hero bg-waves" id="inicio">
  <div class="container">
    <h1 class="hero__title">
      <a href="#proyecto" class="hero__imagotipo" aria-label="AuraVisión, ver el proyecto">
        <Imagotipo size={240} />
      </a>
    </h1>

    <p class="hero__tagline">{hero.tagline}</p>

    <p class="hero__hook">{hero.hook}</p>
    <p class="hero__source">{hero.source}</p>

    <div class="hero__body">
      <div class="aura-card">
        <h2 class="hero__subtitle">El problema</h2>
        <p>{hero.problem}</p>
      </div>
      <div class="aura-card">
        <h2 class="hero__subtitle">La solución</h2>
        <p>{hero.solution}</p>
      </div>
    </div>

    <div class="hero__cta">
      {
        hero.cta.map((cta) => (
          <a
            class:list={['aura-btn', cta.href === '#contacto' && 'aura-btn--outline']}
            href={cta.href}
          >
            {cta.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(7rem, 14vh, 10rem);
    padding-bottom: var(--section-gap);
    text-align: center;
  }

  .hero__tagline {
    font-family: var(--font-brand);
    font-size: clamp(1rem, 2vw, 1.25rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aura-purple-light);
    margin-bottom: var(--gap-md);
  }

  .hero__title {
    margin-bottom: var(--gap-md);
  }

  .hero__imagotipo {
    display: inline-block;
    text-decoration: none;
    filter: drop-shadow(0 0 30px rgba(124, 42, 178, 0.45));
  }

  .hero__imagotipo :global(.imagotipo__logo) {
    font-size: clamp(2rem, 6vw, 3.2rem);
  }

  .hero__hook {
    max-width: 62ch;
    margin: var(--gap-md) auto 0.5rem;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    color: var(--white);
  }

  .hero__source {
    max-width: 62ch;
    margin: 0 auto var(--gap-lg);
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.75;
  }

  .hero__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--gap-md);
    text-align: left;
    margin-bottom: var(--gap-lg);
  }

  .hero__subtitle {
    font-size: 1.1rem;
    color: var(--aura-purple-light);
    margin-bottom: 0.5rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-md);
  }
</style>