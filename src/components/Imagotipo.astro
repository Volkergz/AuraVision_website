---
interface Props {
  size?: number;
  class?: string;
}

const { size = 72, class: className = '' } = Astro.props;
---

<div class:list={['imagotipo', className]}>
  <img class="imagotipo__isotipo" src="/images/isotipo.webp" alt="Isotipo AuraVisión" width={size} height={size} />
  <span class="brand-text imagotipo__logo">
    <span class="brand-aura">Aura</span><span class="brand-vision">Visión</span>
  </span>
</div>

<style>
  .imagotipo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .imagotipo__isotipo {
    object-fit: contain;
  }

  .imagotipo__logo {
    font-size: 1.4rem;
    line-height: 1;
  }
</style>